<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="12.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.downloader.PrimaryController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <Label text="Download Manager" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <TextField fx:id="urlField" promptText="Masukkan URL file (http/https)..." prefWidth="500.0" />

    <HBox spacing="10.0" alignment="CENTER">
        <Button fx:id="downloadButton" text="Download" onAction="#handleDownloadButtonAction" prefWidth="100.0" />
        <Button fx:id="pauseResumeButton" text="Pause" onAction="#handlePauseResumeButtonAction" prefWidth="100.0" disable="true" />
        <Button fx:id="cancelButton" text="Cancel" onAction="#handleCancelButtonAction" prefWidth="100.0" disable="true" />
    </HBox>

    <ProgressBar fx:id="progressBar" prefWidth="500.0" />

    <Label fx:id="statusLabel" text="Status: Siap" />

    <HBox spacing="40.0" alignment="CENTER">
        <Label fx:id="speedLabel" text="Kecepatan: -" />
        <Label fx:id="etaLabel" text="ETA: -" />
    </HBox>
</VBox>
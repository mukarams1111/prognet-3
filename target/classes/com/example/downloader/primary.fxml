<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.downloader.PrimaryController">
    <padding>
        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
    </padding>

    <Label text="Download Manager" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

    <HBox spacing="10.0" alignment="CENTER_LEFT">
        <TextField fx:id="urlField" promptText="Masukkan URL file (http/https)..." HBox.hgrow="ALWAYS" />
        <Button fx:id="addButton" text="Add Download" onAction="#handleAddDownload" prefWidth="120.0" />
    </HBox>

    <TableView fx:id="downloadTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="nameColumn" text="Nama File" prefWidth="240.0" />
            <TableColumn fx:id="statusColumn" text="Status" prefWidth="120.0" />
            <TableColumn fx:id="progressColumn" text="Progress" prefWidth="200.0" />
            <TableColumn fx:id="speedColumn" text="Kecepatan" prefWidth="110.0" />
            <TableColumn fx:id="etaColumn" text="ETA" prefWidth="90.0" />
            <TableColumn fx:id="actionColumn" text="Aksi" prefWidth="240.0" />
        </columns>
    </TableView>
</VBox>